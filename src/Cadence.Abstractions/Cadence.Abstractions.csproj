<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only. .NET 9 left support in May 2026 and .NET 8 follows in November, and nothing
         consumes this yet, so there is no install base to keep on an older floor. If a .NET 8
         consumer ever appears they pin a net8-era release line, which is how libraries normally
         handle a dropped target. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>Job and storage abstractions for Cadence. Referenced by assemblies that implement jobs.</Description>
  </PropertyGroup>

  <!--
    This project is referenced by consumer domain assemblies, so it must not pull in hosting, DI or
    storage. Microsoft.Extensions.Primitives is the single allowed dependency: IChangeToken is the
    schedule-invalidation contract, and the package has no transitive dependencies of its own.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.11" />
  </ItemGroup>

</Project>
