<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <RootNamespace>Cadence.Storage.Sql</RootNamespace>
    <Description>SQL Server storage for Cadence: occurrence claiming, persistent run history, DB-editable schedules, instance registry and janitor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cadence.Core\Cadence.Core.csproj" />
  </ItemGroup>

  <!--
    The schema scripts ship inside the assembly, so the migrator has no file-system dependency.
  -->
  <ItemGroup>
    <SchemaScript Include="Scripts\*.sql" />
    <EmbeddedResource Include="@(SchemaScript)" />
  </ItemGroup>

  <!--
    And are mirrored into scripts/sql/ for anyone applying them by hand with AutoMigrate off. Copied
    by a target rather than checked in twice, so the reviewable copy cannot drift from the one that
    actually runs. Skipped outside the repository, where there is nowhere to copy to.
  -->
  <Target Name="MirrorSchemaScripts"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\scripts')">
    <Copy SourceFiles="@(SchemaScript)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\..\scripts\sql"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.Storage.Sql.Tests" />
  </ItemGroup>

</Project>
