<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Cadence.Sample.Worker</RootNamespace>
  </PropertyGroup>

  <!--
    Cadence comes from the local package feed (see ../NuGet.config), built by
    ../../scripts/pack.ps1. Version floats within 0.2.* so the sample keeps working as the alpha
    iterates without an edit here every time.

    Still Cadence.Core alone, not Cadence.Storage.Sql: this sample exists to prove the telemetry
    fan-out, and it does that on the zero-infrastructure path. The SQL tier is exercised by
    Cadence.Storage.Sql.Tests, and the sample that would show it off needs a dashboard to render
    the history; see samples/README.md.
  -->
  <ItemGroup>
    <PackageReference Include="Cadence.Core" Version="0.2.*-*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <!-- The point of the sample: prove all three telemetry paths at once. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
  </ItemGroup>

</Project>
