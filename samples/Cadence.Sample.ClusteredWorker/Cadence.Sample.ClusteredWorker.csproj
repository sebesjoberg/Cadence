<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Cadence.Sample.ClusteredWorker</RootNamespace>
  </PropertyGroup>

  <!--
    Cadence comes from the local package feed (see ../NuGet.config), built by ../../scripts/pack.ps1.
    Same reason as Cadence.Sample.Worker: a project reference would hide packaging mistakes until the
    first real publish.

    This is also the first thing that consumes Cadence.Storage.Sql as a package rather than by
    project reference, so it is the first check that the SQL tier packs correctly at all.
  -->
  <ItemGroup>
    <PackageReference Include="Cadence.Core" Version="0.2.*-*" />
    <PackageReference Include="Cadence.Storage.Sql" Version="0.2.*-*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <!--
    OTLP rather than the console exporter Cadence.Sample.Worker uses. Aspire runs a dashboard that
    collects OTLP from every replica, which is what turns "one run per occurrence" from a claim into
    something visible: three replicas, one span per scheduled_for.
  -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

</Project>
