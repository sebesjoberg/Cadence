<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The sample consumes Cadence as a package, not as a project reference. That is deliberate: a
    project reference would hide packaging mistakes (a missing dependency, a wrong target framework,
    an internal type that should have been public) until the first real publish.
  -->
  <packageSources>
    <clear />
    <add key="cadence-local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
