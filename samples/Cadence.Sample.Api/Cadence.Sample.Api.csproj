<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Cadence.Sample.Api</RootNamespace>
  </PropertyGroup>

  <!-- From the local feed (../NuGet.config), built by ../../scripts/pack.ps1. -->
  <ItemGroup>
    <PackageReference Include="Cadence.Core" Version="0.2.*-*" />
    <PackageReference Include="Cadence.Api" Version="0.2.*-*" />
    <PackageReference Include="Cadence.Storage.Sql" Version="0.2.*-*" />
  </ItemGroup>

  <!--
    The document comes from the framework; only the UI needs a package. This is the UI half of
    Swashbuckle alone, so nothing here generates a second OpenAPI document, it serves /swagger by
    default, and its assets are embedded rather than fetched from a CDN.

    10.0.11 rather than the 10.0.0 its siblings pin: 10.0.0 resolves Microsoft.OpenApi 2.0.0, which
    restore rejects as a known vulnerability (NU1903).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
